/* qt_style.qss */
* {
    font-family: 'Roboto Mono';
    background-color: #FFFFFF;
    color: #4F5D75;
    font-size: 10pt;
}
/* Base styles */
QMainWindow {
    background-color: #f5f5f5;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 1ex;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #333;
}

/* Buttons container */
QGroupBox#buttonGroup {
    border-radius: 5px;
    background: #4F5D75; 
    margin: 8px;
    padding: 4px;
}

/* Individual buttons */
QPushButton {
    min-width: 285px;
    min-height: 34px;
    padding: 5px 14px;
    border-radius: 5px;
    background: #919AA8; 
    color: #FFFFFF;
    border: none;
    margin: 2px;
    font-weight: bold;
}

QPushButton:hover:enabled {
    background: #7E8AA2;
}

QPushButton:pressed, QPushButton:checked {
    background: #4F5D75; 
}

QPushButton:disabled {
    background: rgba(228, 228, 228, 0.20);
    color: rgba(79, 93, 117, 0.5);
}

/* Text input fields */
QLineEdit {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 8px;
    background-color: white;
}

QLineEdit:focus {
    border: 1px solid #2196F3;
}

QTextEdit, QPlainTextEdit {
    min-height: 24px;
    padding: 5px;
    border-radius: 5px;
    border: 1px solid #e0e0e0;
    background: white;
    color: #000000;
    selection-background-color: #2196F3;
    selection-color: white;
}

QLineEdit, QTextEdit, QPlainTextEdit, QTableWidget {
    border-radius: 5px;
    background-color: white;
}

/* Table */
QTableWidget {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: white;
}

QTableWidget:hover {
}

QHeaderView::section {
    background-color: #f5f5f5;
    padding: 6px;
    border: 1px solid #e0e0e0;
    color: #333;
}

QTableCornerButton::section {
    background-color: #f5f5f5;
}

/* Item hover (10% opacity) */
QTableWidget::item:hover {
    background-color: rgba(79, 93, 117, 0.10);
    border-radius: 5px;
}

/* Item selected (30% opacity, gray tint) */
QTableWidget::item:selected {
    background-color: rgba(117, 117, 117, 0.1);
    border-radius: 5px;
}

/* Override default Qt highlight for table items */
QTableView::item:selected {
    background-color: rgba(128, 128, 128, 0.30);
    border-radius: 5px;
}
QTableView::item:selected:active {
    background-color: rgba(128, 128, 128, 0.30);
}

/* Header hover (10% opacity) */
QHeaderView::section:hover {
    background-color: rgba(79, 93, 117, 0.10);
    border-radius: 5px;
}

/* Header pressed (30% opacity) */
QHeaderView::section:pressed {
    background-color: rgba(79, 93, 117, 0.30);
    border-radius: 5px;
}
/* Hide scrollbars when not hovered */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 0px;
    height: 0px;
}
QScrollBar:vertical:hover, QScrollBar:horizontal:hover {
    width: 8px;
    height: 8px;
}
QScrollBar::handle {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}
QScrollBar::handle:hover {
    background: rgba(0, 0, 0, 0.5);
}


/* Make editors in table cells match cell size and style */
QTableWidget QLineEdit {
    min-width: 0;
    height: 100%;           /* fill the cell vertically */
    margin: 0;              /* no extra margins */
    padding: 3px 8px;       /* match table cell padding */
    border-radius: 5px;
    background: rgba(145, 154, 168, 0.1);
}
